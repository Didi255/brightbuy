# Copy to .env and adjust. NEVER commit .env
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=brightbuy
DB_PASSWORD=brightbuy
DB_NAME=brightbuy

PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# The city the physical store is in. Used as delivery.city_id for Store Pickup
# orders, which have no delivery address (DECISIONS #23).
# MUST be a city with is_main_city = TRUE, or pickup orders get a 7-day estimate
# instead of 5 and REQ-7.5 breaks. The server asserts this at startup.
STORE_CITY_ID=1

CLIENT_ORIGIN=http://localhost:5173
