# BrightBuy — environment template.
#
# Copy this to `.env` IN THIS FOLDER for a local run, and to
# /opt/brightbuy/.env on the VM for production. `.env` is gitignored;
# this example file is not, and must never contain a real secret.
#
#   cp infrastructure/azure/.env.example infrastructure/azure/.env
#
# Generate each secret with:   openssl rand -base64 36
# On Windows without openssl:  [Convert]::ToBase64String((1..36|%{Get-Random -Max 256}))

# ── database ────────────────────────────────────────────────────────
# These three are baked into the MySQL data volume the FIRST time it
# starts. Changing them afterwards does nothing to an existing volume.
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=brightbuy
DB_USER=brightbuy
DB_PASSWORD=change-me-app

# ── api ─────────────────────────────────────────────────────────────
JWT_SECRET=change-me-long-random
JWT_EXPIRES_IN=8h
# The city orders are dispatched from. 1 = Colombo in the seed data.
STORE_CITY_ID=1

# ── public address ──────────────────────────────────────────────────
# PRODUCTION: the real hostname, e.g.
#   APP_DOMAIN=brightbuy-g13.southindia.cloudapp.azure.com
# Caddy sees a real hostname and gets a Let's Encrypt certificate for it.
#
# LOCAL: a bare port. ":80" tells Caddy "serve plain HTTP, do not try to
# get a certificate" — which is what you want on a laptop with no public
# DNS. Then open http://localhost
APP_DOMAIN=:80

# ── images ──────────────────────────────────────────────────────────
# PRODUCTION: the GHCR paths, owner in lowercase. IMAGE_TAG is rewritten
# by every deploy, so you never set it by hand except to roll back.
#   API_IMAGE=ghcr.io/<owner>/brightbuy-api
#   WEB_IMAGE=ghcr.io/<owner>/brightbuy-web
#   IMAGE_TAG=<commit sha>
#
# LOCAL: the tags you just built with `docker build -t brightbuy-api:local`
API_IMAGE=brightbuy-api
WEB_IMAGE=brightbuy-web
IMAGE_TAG=local
